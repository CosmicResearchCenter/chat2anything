# Chat2Anything 环境配置模板
# 复制此文件为 .env (生产环境) 或 .env.dev (开发环境) 并修改配置

# ==================== 基础配置 ====================
# 安全密钥 (生产环境请使用强密码)
SECRET_KEY=your_secret_key_here_change_this_in_production
ADMIN_KEY=your_admin_key_here_change_this_in_production

# ==================== Web 服务配置 ====================
# Web 端口 (Nginx 监听端口)
WEB_PORT=9966

# ==================== MySQL 数据库配置 ====================
MYSQL_IP=chat2anything_db
MYSQL_PORT=3306
MYSQL_BASE=chat2anything_db
MYSQL_USER=chat2anything_user
MYSQL_PASSWORD=your_mysql_password_here

# ==================== Elasticsearch 配置 ====================
ES_BASE_URL=chat2anything_es
ES_BASE_PORT=9200

# ==================== Milvus 向量数据库配置 ====================
MILVUS_HOST=chat2anything_milvus
MILVUS_PORT=19530

# ==================== 业务配置 ====================
# 文本分割模型 (0: 默认)
SPPLITTER_MODEL=0

# ==================== 开发环境专用配置 ====================
# 开发环境数据库端口 (避免与生产环境冲突)
# MYSQL_PORT_DEV=3307
# ES_BASE_PORT_DEV=9201
# MILVUS_PORT_DEV=19531
# WEB_PORT_DEV=9967
